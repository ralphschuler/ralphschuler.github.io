{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "hexo generate && hexo generate --config _config.yml,_config.en.yml --output .cache/hexo-en",
    "clean": "hexo clean && hexo clean --config _config.yml,_config.en.yml --output .cache/hexo-en",
    "deploy": "hexo deploy",
    "server": "hexo server",
    "sync-projects": "node .github/scripts/sync-pages-projects.mjs",
    "test": "node --test"
  },
  "hexo": {
    "version": "7.3.0"
  },
  "dependencies": {
    "hexo": "^7.2.0",
    "hexo-deployer-git": "^4.0.0",
    "hexo-featured-image": "^0.4.3",
    "hexo-generator-archive": "^1.0.0",
    "hexo-generator-category": "^1.0.0",
    "hexo-generator-feed": "^3.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-tag": "^1.0.0",
    "hexo-renderer-ejs": "^1.0.0",
    "hexo-renderer-marked": "^7.0.1",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^2.0.0"
  }
}
